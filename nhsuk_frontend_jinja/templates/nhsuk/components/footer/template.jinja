{% from "nhsuk/components/heading/macro.jinja" import heading as nhsukHeading %}
{% from "nhsuk/macros/attributes.jinja" import nhsukAttributes %}

{#- Set classes for this component #}
{%- set classNames = "nhsuk-footer" -%}

{#- Support meta as string #}
{%- set meta = params.meta if params.meta is mapping else {
  "text": params.meta if params.meta is string else undefined,
  "html": params.meta if params.meta is defined and params.meta is escaped else undefined
} -%}

{#- Support copyright as string #}
{%- set copyright = params.copyright if params.copyright is mapping else {
  "text": params.copyright if params.copyright is string else undefined,
  "html": params.copyright if params.copyright is defined and params.copyright is escaped else undefined
} -%}

{%- if params.classes %}
  {% set classNames = classNames ~ " " ~ params.classes %}
{% endif %}

{%- set columns = params.columns | default(4, true) -%}

{% if columns == 1 %}
  {% set width = "full" %}
{% elif columns == 2 %}
  {% set width = "one-half" %}
{% elif columns == 3 %}
  {% set width = "one-third" %}
{% else %}
  {% set width = "one-quarter" %}
  {% set columns = 4 %}
{% endif -%}

{% macro _footerList(items, modifier) %}
<ul class="nhsuk-footer__list">
{% for item in items %}
  {% if item %}
  <li class="nhsuk-footer__list-item">
    <a class="nhsuk-footer__list-item-link" href="{{ item.href }}"
      {{- nhsukAttributes(item.attributes) }}>
      {{- item.html | safe | trim | indent(6) if item.html else item.text -}}
    </a>
  </li>
  {% endif %}
{% endfor %}
</ul>
{% endmacro -%}

<footer class="{{ classNames }}" {%- if params.id %} id="{{ params.id }}"{% endif %} role="contentinfo"
  {{- nhsukAttributes(params.attributes) }}>
  <div class="nhsuk-width-container {%- if params.containerClasses %} {{ params.containerClasses }}{% endif %}">
{% if params.navigation %}
  {% for row in ([params.navigation] if params.navigation is mapping else params.navigation) | batch(columns) %}
    <div class="nhsuk-footer__navigation nhsuk-grid-row">
    {% for navigation in row %}
      <div class="nhsuk-grid-column-{{ navigation.width | default(width, true) }}">
      {% if navigation.heading or navigation.title %}
        {#- Support navigation heading as string (with deprecated options) #}
        {%- set heading = navigation.heading if navigation.heading is mapping else {
          "text": navigation.heading if navigation.heading is string else navigation.title,
          "html": navigation.heading if navigation.heading is defined and navigation.heading is escaped else undefined
        } -%}

        {{- nhsukHeading({
          "id": heading.id,
          "text": heading.text,
          "html": heading.html,
          "visuallyHiddenText": heading.visuallyHiddenText,
          "caption": heading.caption,
          "href": heading.href,
          "level": 2,
          "size": "s",
          "className": "nhsuk-footer__heading",
          "classPrefix": "nhsuk-heading-",
          "classes": heading.classes,
          "attributes": heading.attributes
        }) | trim | indent(8, true) }}
      {% endif %}
      {% if navigation.html %}
        {{ navigation.html | safe | trim | indent(8) }}
      {% elif navigation.text %}
        <p class="nhsuk-body-s">{{ navigation.text | trim | indent(8) }}</p>
      {% endif %}
      {% if navigation.get("items", undefined) %}
        {{ _footerList(navigation.get("items", undefined)) | trim | indent(8) }}
      {% endif %}
      </div>
    {% endfor %}
    </div>
  {% endfor %}
{% endif %}
    <div class="nhsuk-footer__meta">
{% if caller or meta.get("items", undefined) | length or meta.text or meta.html %}
    {% if meta.get("items", undefined) %}
      <h2 class="nhsuk-u-visually-hidden">
        {{- meta.visuallyHiddenText | default(meta.visuallyHiddenTitle) | default("Support links") -}}
      </h2>
      {{ _footerList(meta.get("items", undefined)) | trim | indent(6) }}
    {% endif %}
    {% if caller %}
      {{- caller() }}
    {% elif meta.html %}
      {{ meta.html | safe | trim | indent(6) }}
    {% elif meta.text %}
      <p class="nhsuk-body-s">{{ meta.text | trim | indent(6) }}</p>
    {% endif %}
{% endif %}
    {% if copyright.html %}
      {{ copyright.html | safe | trim | indent(6) }}
    {% elif copyright.text or copyright.text not in ["", none, false] %}
      <p class="nhsuk-body-s">{{ (copyright.text | default("© NHS England", true)) | indent(6) }}</p>
    {% endif %}
    </div>
  </div>
</footer>
